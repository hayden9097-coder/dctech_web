---
layout: base.njk
title: 회사소개
---
<section class="page-hero grid-overlay relative pt-20 pb-16 md:pt-24 md:pb-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <p class="text-sm font-bold text-techblue-300 tracking-wider mb-3">{{ about.eyebrow }}</p>
    <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-snug max-w-2xl">{{ about.title }}</h1>
  </div>
</section>

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-5" id="greeting">
        <p class="text-slate-600 leading-relaxed">{{ about.intro }}</p>
        <div class="mt-8 flex items-start gap-4 p-4 rounded-xl bg-navy-900/5 border border-navy-900/10">
          <svg class="w-10 h-10 text-techblue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          <p class="text-sm text-navy-800 font-medium leading-relaxed">
            "{{ about.quote }}"
            <span class="block mt-1 text-xs text-slate-500">{{ about.quote_source }}</span>
          </p>
        </div>

        <h2 id="values" class="mt-12 text-sm font-bold text-slate-400 tracking-wider mb-6">{{ about.values_title | upper }}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {% for v in about.values %}
          <div class="p-4 rounded-xl border border-slate-200">
            <p class="font-bold text-navy-900 text-sm mb-1">{{ v.title }}</p>
            <p class="text-xs text-slate-500 leading-relaxed">{{ v.desc }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="lg:col-span-7" id="history">
        <p class="text-sm font-bold text-slate-400 tracking-wider mb-6">{{ about.history_title | upper }}</p>
        <ol class="relative border-l-2 border-navy-900/10 space-y-10 pl-8">
          {% for h in about.history %}
          <li class="relative">
            <span class="absolute -left-[41px] top-0 w-5 h-5 rounded-full {{ 'bg-white border-2 border-techblue-500' if loop.last else 'bg-techblue-500' }} ring-4 ring-techblue-500/15"></span>
            <p class="text-techblue-500 font-bold text-sm">{{ h.date }}</p>
            <p class="font-bold text-navy-900 mt-1">{{ h.title }}</p>
            <p class="text-sm text-slate-500 mt-1">{{ h.desc }}</p>
          </li>
          {% endfor %}
        </ol>
      </div>
    </div>
  </div>
</section>

{% if about.org_image %}
<section id="organization" class="py-16 md:py-24 bg-slate-50">
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
    <h2 class="text-xl md:text-3xl font-extrabold text-navy-900">{{ about.org_title }}</h2>
    {% if about.org_desc %}
    <p class="mt-4 text-slate-600 leading-relaxed max-w-2xl mx-auto">{{ about.org_desc }}</p>
    {% endif %}
    <figure class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-10">
      <img src="{{ about.org_image }}" alt="{{ site.company_name_kr }} 조직도"
           class="w-full max-w-2xl h-auto mx-auto" loading="lazy" decoding="async">
    </figure>
  </div>
</section>
{% endif %}
