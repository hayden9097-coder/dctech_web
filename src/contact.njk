---
layout: base.njk
title: 문의하기
---
<section class="page-hero grid-overlay relative pt-20 pb-16 md:pt-24 md:pb-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <p class="text-sm font-bold text-techblue-300 tracking-wider mb-3">{{ contact.eyebrow }}</p>
    <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-snug max-w-2xl">{{ contact.title }}</h1>
    <p class="mt-4 text-slate-400 max-w-2xl">{{ contact.intro }}</p>
  </div>
</section>

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <div class="space-y-5 text-sm">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-navy-900/5 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <p class="text-slate-500">본사 주소</p>
              <p class="text-navy-900 font-medium">{{ site.address }}</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-navy-900/5 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <p class="text-slate-500">전화</p>
              <p class="text-navy-900 font-medium">{{ site.phone }} &nbsp;|&nbsp; {{ site.phone2 }}</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-navy-900/5 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-slate-500">이메일</p>
              <p class="text-navy-900 font-medium">{{ site.email }}</p>
            </div>
          </div>
        </div>

        <div class="mt-12">
          <h2 class="text-sm font-bold text-slate-400 tracking-wider mb-6">{{ contact.faq_title | upper }}</h2>
          <div class="space-y-4">
            {% for f in contact.faq %}
            <details class="group border border-slate-200 rounded-xl p-4">
              <summary class="font-medium text-navy-900 text-sm cursor-pointer list-none flex items-center justify-between">
                {{ f.q }}
                <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="text-sm text-slate-500 leading-relaxed mt-3">{{ f.a }}</p>
            </details>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form class="bg-slate-50 rounded-2xl p-6 md:p-10 border border-slate-200">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-semibold text-navy-900 mb-2">이름 <span class="text-techblue-500">*</span></label>
              <input type="text" required placeholder="홍길동" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-techblue-500 focus:ring-2 focus:ring-techblue-500/20 outline-none text-sm transition bg-white">
            </div>
            <div>
              <label class="block text-sm font-semibold text-navy-900 mb-2">회사명 <span class="text-techblue-500">*</span></label>
              <input type="text" required placeholder="(주)디씨테크" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-techblue-500 focus:ring-2 focus:ring-techblue-500/20 outline-none text-sm transition bg-white">
            </div>
            <div>
              <label class="block text-sm font-semibold text-navy-900 mb-2">연락처 <span class="text-techblue-500">*</span></label>
              <input type="tel" required placeholder="010-0000-0000" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-techblue-500 focus:ring-2 focus:ring-techblue-500/20 outline-none text-sm transition bg-white">
            </div>
            <div>
              <label class="block text-sm font-semibold text-navy-900 mb-2">이메일</label>
              <input type="email" placeholder="example@company.com" class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-techblue-500 focus:ring-2 focus:ring-techblue-500/20 outline-none text-sm transition bg-white">
            </div>
            <div class="sm:col-span-2">
              <label class="block text-sm font-semibold text-navy-900 mb-2">문의내용 <span class="text-techblue-500">*</span></label>
              <textarea required rows="5" placeholder="도입을 검토 중인 설비 종류, 현재 겪고 계신 문제, 희망 도입 시기 등을 자유롭게 남겨주세요." class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:border-techblue-500 focus:ring-2 focus:ring-techblue-500/20 outline-none text-sm transition resize-none bg-white"></textarea>
            </div>
          </div>
          <label class="flex items-start gap-2 mt-5 text-xs text-slate-500">
            <input type="checkbox" required class="mt-0.5 accent-techblue-500">
            {{ contact.privacy_note }}
          </label>
          <button type="submit" class="mt-6 w-full bg-techblue-500 hover:bg-techblue-400 text-white font-bold py-3.5 rounded-lg transition-colors shadow-lg shadow-techblue-500/20">
            {{ contact.submit_label }}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
