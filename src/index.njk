---
layout: base.njk
title: 홈
---
<section class="gradient-hero grid-overlay relative pt-20 pb-24 md:pt-28 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 text-xs font-semibold text-techblue-300 bg-techblue-500/10 border border-techblue-500/30 rounded-full px-3 py-1 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-techblue-300 animate-pulse"></span>
        {{ home.hero_badge }}
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
        {{ home.hero_title_line1 }}<br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-techblue-300 to-techblue-500">{{ home.hero_title_line2 }}</span>
      </h1>
      <p class="mt-6 text-base md:text-lg text-slate-300 leading-relaxed">
        {{ home.hero_subtitle }}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a href="{{ home.cta_primary_url }}" class="inline-flex items-center justify-center gap-2 bg-techblue-500 hover:bg-techblue-400 text-white font-semibold px-6 py-3.5 rounded-lg shadow-lg shadow-techblue-500/20 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          {{ home.cta_primary_label }}
        </a>
        <a href="{{ home.cta_secondary_url }}" class="inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          {{ home.cta_secondary_label }}
        </a>
      </div>

      <div class="mt-16 grid grid-cols-3 gap-6 max-w-xl border-t border-white/10 pt-8">
        {% for s in home.stats %}
        <div>
          <p class="num-badge text-2xl md:text-3xl font-bold text-white">{{ s.value }}<span class="text-techblue-300">{{ s.suffix }}</span></p>
          <p class="text-xs md:text-sm text-slate-400 mt-1">{{ s.label }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="max-w-2xl mb-14">
      <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 leading-snug">{{ home.intro_title }}</h2>
      <p class="mt-4 text-slate-600 leading-relaxed">{{ home.intro_body }}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {% for card in home.highlight_cards %}
      <a href="{{ card.link_url }}" class="card-hover block bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-techblue-500/10 flex items-center justify-center mb-5">
          {% if card.icon == "about" %}
          <svg class="w-6 h-6 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          {% elif card.icon == "solutions" %}
          <svg class="w-6 h-6 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          {% else %}
          <svg class="w-6 h-6 text-techblue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          {% endif %}
        </div>
        <h3 class="text-lg font-bold text-navy-900 mb-2">{{ card.title }}</h3>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ card.desc }}</p>
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-techblue-500">
          {{ card.link_label }}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-20 md:py-24 bg-navy-900 relative overflow-hidden">
  <div class="absolute inset-0 grid-overlay opacity-30"></div>
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-snug">{{ home.cta_banner_title }}</h2>
    <p class="mt-4 text-slate-400">{{ home.cta_banner_desc }}</p>
    <a href="/contact/" class="mt-8 inline-flex items-center justify-center gap-2 bg-techblue-500 hover:bg-techblue-400 text-white font-semibold px-8 py-3.5 rounded-lg shadow-lg shadow-techblue-500/20 transition-colors">
      {{ home.cta_banner_button }}
    </a>
  </div>
</section>
