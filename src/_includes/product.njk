---
layout: base.njk
---
<section class="page-hero grid-overlay relative pt-16 pb-16 md:pt-20 md:pb-20">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <a href="/products/" class="inline-flex items-center gap-1.5 text-sm text-techblue-300 hover:text-white transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      제품 목록으로
    </a>
    {% if category %}
    <span class="inline-block text-xs font-bold text-techblue-300 bg-techblue-500/10 border border-techblue-500/30 rounded-full px-3 py-1 mb-4">{{ category }}</span>
    {% endif %}
    <h1 class="text-2xl md:text-4xl font-extrabold text-white leading-snug">{{ title }}</h1>
    <p class="mt-3 text-slate-400 max-w-2xl">{{ summary }}</p>
  </div>
</section>

<section class="py-14 md:py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7">
        {% if image %}
        <img src="{{ image }}" alt="{{ title }}" class="w-full rounded-2xl border border-slate-200 mb-8">
        {% endif %}

        <article class="prose prose-slate max-w-none prose-h2:text-xl prose-h2:font-bold prose-h2:text-navy-900 prose-h2:mt-8 prose-h2:mb-3 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600">
          {{ content | safe }}
        </article>
      </div>

      <aside class="lg:col-span-5 space-y-6">
        {% if features and features | length %}
        <div class="bg-navy-950 rounded-2xl p-6">
          <p class="text-xs font-bold text-techblue-300 tracking-wider mb-4">주요 특징</p>
          <ul class="space-y-3">
            {% for f in features %}
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-techblue-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-sm text-slate-300">{{ f }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if specs and specs | length %}
        <div class="border border-slate-200 rounded-2xl p-6">
          <p class="text-xs font-bold text-slate-400 tracking-wider mb-4">제품 사양</p>
          <dl class="divide-y divide-slate-100">
            {% for s in specs %}
            <div class="py-2.5 flex justify-between gap-4 text-sm">
              <dt class="text-slate-500 shrink-0">{{ s.label }}</dt>
              <dd class="text-navy-900 font-medium text-right">{{ s.value }}</dd>
            </div>
            {% endfor %}
          </dl>
        </div>
        {% endif %}

        {% if brochure %}
        <a href="{{ brochure }}" download class="flex items-center gap-3 p-5 rounded-2xl border-2 border-techblue-500/30 bg-techblue-50 hover:bg-techblue-100 transition-colors">
          <svg class="w-8 h-8 text-techblue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>
            <span class="block font-bold text-navy-900 text-sm">제품 카탈로그 다운로드</span>
            <span class="block text-xs text-slate-500 mt-0.5">PDF 파일로 상세 사양을 확인하세요</span>
          </span>
        </a>
        {% endif %}

        <a href="/contact/" class="block text-center bg-techblue-500 hover:bg-techblue-400 text-white font-bold py-3.5 rounded-lg transition-colors shadow-lg shadow-techblue-500/20">
          이 제품 문의하기
        </a>
      </aside>
    </div>
  </div>
</section>
