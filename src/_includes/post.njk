---
layout: base.njk
---
<section class="page-hero grid-overlay relative pt-16 pb-14 md:pt-20 md:pb-16">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    <a href="/news/" class="inline-flex items-center gap-1.5 text-sm text-techblue-300 hover:text-white transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      소식 목록으로
    </a>
    <div class="flex items-center gap-3 mb-4">
      <span class="text-xs font-bold text-techblue-300 bg-techblue-500/10 border border-techblue-500/30 rounded-full px-3 py-1">{{ category }}</span>
      <time class="text-xs text-slate-400">{{ date | date }}</time>
    </div>
    <h1 class="text-2xl md:text-3xl font-extrabold text-white leading-snug">{{ title }}</h1>
  </div>
</section>

<section class="py-14 md:py-20 bg-white">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">
    {% if thumbnail %}
    <img src="{{ thumbnail }}" alt="{{ title }}" class="w-full rounded-2xl border border-slate-200 mb-10">
    {% endif %}

    <article class="prose prose-slate max-w-none prose-h2:text-xl prose-h2:font-bold prose-h2:text-navy-900 prose-h2:mt-8 prose-h2:mb-3 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600 prose-a:text-techblue-500">
      {{ content | safe }}
    </article>

    {% if attachment %}
    <a href="{{ attachment }}" download class="mt-10 flex items-center gap-3 p-5 rounded-2xl border-2 border-techblue-500/30 bg-techblue-50 hover:bg-techblue-100 transition-colors">
      <svg class="w-8 h-8 text-techblue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <span>
        <span class="block font-bold text-navy-900 text-sm">첨부파일 다운로드</span>
        <span class="block text-xs text-slate-500 mt-0.5">클릭하면 파일이 다운로드됩니다</span>
      </span>
    </a>
    {% endif %}

    <div class="mt-12 pt-8 border-t border-slate-200">
      <a href="/news/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-techblue-500 hover:text-techblue-400 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        목록으로 돌아가기
      </a>
    </div>
  </div>
</section>
