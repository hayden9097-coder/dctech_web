{# AssetPulse 전용 제품 상세 템플릿 — 기존 CMS 필드(제품명·분류·한줄 요약·대표 이미지·주요 특징·제품 사양·카탈로그 PDF·상세 설명)를 모두 그대로 사용한다.
   고정 문구(히어로·기능·구조 설명)는 src/_data/assetpulse.json, 화면 이미지는 public/images/assetpulse/ 에 있다. #}
{% macro shot(file, alt, caption) %}
<figure>
  <a href="/images/assetpulse/{{ file }}.webp" target="_blank" rel="noopener" data-ui class="block rounded-xl overflow-hidden border border-slate-200 bg-white" aria-label="{{ alt }} (크게 보기, 새 탭)">
    <img src="/images/assetpulse/{{ file }}.webp" alt="{{ alt }}" loading="lazy" decoding="async" class="block w-full h-auto">
  </a>
  {% if caption %}<figcaption class="mt-3 text-sm text-slate-500 break-keep">{{ caption }}</figcaption>{% endif %}
</figure>
{% endmacro %}
{% set ap = assetpulse %}
{% set dl = brochure or '/downloads/' %}

{# ───── 히어로: 단색 네이비 + 큰 제목 + 실제 대시보드 ───── #}
<section class="bg-navy-900 pt-10 pb-14 md:pt-14 md:pb-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <a href="/products/" class="inline-flex items-center gap-1.5 text-sm text-techblue-300 hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      제품 목록으로
    </a>
    {% if image %}<img src="{{ image }}" alt="{{ title }} 로고" class="mt-8 h-16 w-16 rounded-xl bg-white object-contain p-1">{% endif %}
    <div class="mt-6 grid lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      <h1 class="lg:col-span-8 text-4xl sm:text-5xl lg:text-[56px] xl:text-6xl font-extrabold text-white leading-[1.15] break-keep">{{ ap.hero.headline }}</h1>
      <div class="lg:col-span-4">
        <p class="text-slate-300 leading-relaxed break-keep">{{ ap.hero.lead }}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="{{ dl }}" {% if brochure %}download{% endif %} class="inline-flex items-center bg-[#1d63d8] hover:bg-techblue-500 text-white font-bold px-6 py-3.5 rounded-lg transition-colors">제품 소개서 다운로드</a>
          <a href="/contact/" class="inline-flex items-center border-2 border-white/40 hover:bg-white/10 text-white font-bold px-6 py-3 rounded-lg transition-colors">문의하기</a>
        </div>
      </div>
    </div>
    <div class="mt-12 [&_figcaption]:text-slate-400">
      {{ shot(ap.hero.image, ap.hero.image_alt, title ~ " — 대시보드") }}
    </div>
  </div>
</section>

{# ───── 핵심 가치: 데이터 흐름 + 6대 기능 ───── #}
<section class="bg-white pt-14 md:pt-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <p class="text-center text-slate-600 break-keep">펌프 · 모터 · 팬 · 압축기 등 회전설비의 상태를 알람과 정비까지 하나의 흐름으로 연결합니다.</p>
    <ol class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-3" aria-label="데이터 흐름">
      {% for step in ap.flow %}
      <li class="flex items-center gap-2">
        <span class="bg-techblue-50 text-navy-900 rounded-lg px-4 py-2.5 text-sm font-semibold">{{ step }}</span>
        {% if not loop.last %}<span class="text-techblue-500 hidden sm:inline" aria-hidden="true">→</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
<section class="bg-white py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 break-keep">AssetPulse의 핵심 기능</h2>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for c in ap.capabilities %}
      <div class="bg-slate-50 rounded-xl p-6">
        <h3 class="text-lg font-bold text-navy-900 break-keep">{{ c.title }}</h3>
        <p class="mt-2 text-slate-600 leading-relaxed break-keep">{{ c.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ───── 통합 자산 관리 ───── #}
{% set s = ap.sections[0] %}
<section id="asset" class="bg-slate-50 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <div class="lg:col-span-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 leading-snug break-keep">{{ s.title }}</h2>
      <p class="mt-4 text-slate-600 leading-relaxed break-keep">{{ s.text }}</p>
      <ul class="mt-5 space-y-2 text-slate-700">{% for b in s.bullets %}<li class="flex gap-2 break-keep"><svg class="w-4 h-4 mt-1.5 text-techblue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>{{ b }}</li>{% endfor %}</ul>
    </div>
    <div class="lg:col-span-8">{{ shot(s.images[0].file, s.images[0].alt, s.images[0].caption) }}</div>
  </div>
</section>

{# ───── 센서 연결 ───── #}
{% set s = ap.sections[1] %}
<section id="sensors" class="bg-navy-900 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    <div class="lg:col-span-6 order-2 lg:order-1 [&_figcaption]:text-slate-400">{{ shot(s.images[0].file, s.images[0].alt, s.images[0].caption) }}</div>
    <div class="lg:col-span-6 order-1 lg:order-2">
      <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-snug break-keep">{{ s.title }}</h2>
      <p class="mt-4 text-slate-300 leading-relaxed break-keep">{{ s.text }}</p>
      <ul class="mt-6 grid sm:grid-cols-2 gap-3">
        {% for b in s.bullets %}<li class="bg-white/10 text-white rounded-lg px-4 py-3 text-[15px] font-medium break-keep">{{ b }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ───── 실시간 상태감시 ───── #}
{% set s = ap.sections[2] %}
<section id="monitoring" class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 leading-snug break-keep">{{ s.title }}</h2>
      <p class="mt-4 text-slate-600 leading-relaxed break-keep">{{ s.text }}</p>
    </div>
    <div class="mt-10 grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7">{{ shot(s.images[0].file, s.images[0].alt, s.images[0].caption) }}</div>
      <div class="lg:col-span-5">{{ shot(s.images[1].file, s.images[1].alt, s.images[1].caption) }}</div>
    </div>
  </div>
</section>

{# ───── 측정 · 분석 ───── #}
{% set s = ap.sections[3] %}
<section id="analysis" class="bg-slate-50 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-7"><h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 leading-snug break-keep">{{ s.title }}</h2></div>
      <div class="lg:col-span-5"><p class="text-slate-600 leading-relaxed break-keep">{{ s.text }}</p></div>
    </div>
    <div class="mt-10 grid md:grid-cols-2 gap-6">
      {{ shot(s.images[0].file, s.images[0].alt, s.images[0].caption) }}
      {{ shot(s.images[1].file, s.images[1].alt, s.images[1].caption) }}
    </div>
    <div class="mt-6">{{ shot(s.images[2].file, s.images[2].alt, s.images[2].caption) }}</div>
  </div>
</section>

{# ───── 알람 · 정비 ───── #}
{% set s = ap.sections[4] %}
<section id="alarm" class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 leading-snug break-keep">{{ s.title }}</h2>
      <p class="mt-4 text-slate-600 leading-relaxed break-keep">{{ s.text }}</p>
    </div>
    <ol class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-3" aria-label="알람에서 정비까지">
      {% for step in ap.flow %}
      <li class="flex items-center gap-2"><span class="bg-techblue-50 text-navy-900 rounded-lg px-4 py-2.5 text-sm font-semibold">{{ step }}</span>{% if not loop.last %}<span class="text-techblue-500 hidden sm:inline" aria-hidden="true">→</span>{% endif %}</li>
      {% endfor %}
    </ol>
    <div class="mt-10 grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7">{{ shot(s.images[0].file, s.images[0].alt, s.images[0].caption) }}</div>
      <div class="lg:col-span-5 grid gap-6">
        {{ shot(s.images[1].file, s.images[1].alt, s.images[1].caption) }}
        {{ shot(s.images[2].file, s.images[2].alt, s.images[2].caption) }}
      </div>
    </div>
  </div>
</section>

{# ───── 시스템 구조 · 도입 형태 ───── #}
<section id="architecture" class="bg-slate-50 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 break-keep">센서에서 서버까지, 하나의 구조로 연결됩니다</h2>
    <ol class="mt-10 flex flex-col md:flex-row gap-3 md:items-stretch" aria-label="시스템 구조">
      {% for a in ap.arch %}
      <li class="flex md:contents flex-col">
        <div class="bg-white rounded-xl p-5 flex-1"><p class="font-bold text-navy-900 break-keep">{{ a.title }}</p><p class="mt-1 text-sm text-slate-500 break-keep">{{ a.text }}</p></div>
        {% if not loop.last %}<div class="self-center text-techblue-500 text-xl py-1 md:py-0 rotate-90 md:rotate-0" aria-hidden="true">→</div>{% endif %}
      </li>
      {% endfor %}
    </ol>
    <h3 class="mt-14 text-xl md:text-2xl font-extrabold text-navy-900 break-keep">도입 형태</h3>
    <div class="mt-6 grid md:grid-cols-3 gap-4">
      {% for d in ap.deploy %}
      <div class="bg-white rounded-xl p-6"><h4 class="font-bold text-navy-900 text-lg break-keep">{{ d.title }}</h4><p class="mt-2 text-slate-600 leading-relaxed break-keep">{{ d.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

{# ───── 제품 사양 (CMS 사양 표) ───── #}
<section id="specs" class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4"><h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 break-keep">제품 사양</h2></div>
    <div class="lg:col-span-8">
      <table class="w-full text-[15px]">
        <caption class="sr-only">{{ title }} 제품 사양</caption>
        <tbody>
          <tr class="border-t border-slate-200"><th scope="row" class="py-4 pr-6 text-left font-medium text-slate-500 w-32 sm:w-44 align-top">제품명</th><td class="py-4 text-navy-900 font-medium break-keep">{{ title }}</td></tr>
          {% if category %}<tr class="border-t border-slate-200"><th scope="row" class="py-4 pr-6 text-left font-medium text-slate-500 align-top">제품 분류</th><td class="py-4 text-navy-900 font-medium break-keep">{{ category }}</td></tr>{% endif %}
          {% for sp in specs %}
          <tr class="border-t border-slate-200"><th scope="row" class="py-4 pr-6 text-left font-medium text-slate-500 align-top">{{ sp.label }}</th><td class="py-4 text-navy-900 font-medium break-keep">{{ sp.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{# ───── 주요 특징 (CMS 목록을 카드로) ───── #}
{% if features and features | length %}
<section id="features" class="bg-slate-50 py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 break-keep">주요 특징</h2>
    <ul class="mt-10 grid md:grid-cols-2 gap-4">
      {% for f in features | featureItems %}
      <li class="bg-white rounded-xl p-6">
        <div><p class="font-semibold text-navy-900 leading-snug break-keep">{{ f.title }}</p>{% if f.detail %}<p class="mt-1.5 text-slate-600 leading-relaxed break-keep">{{ f.detail }}</p>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{# ───── 상세 제품 소개 (CMS 한줄 요약 + 상세 설명) ───── #}
<section id="detail" class="bg-white py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4"><h2 class="text-2xl md:text-3xl font-extrabold text-navy-900 break-keep">상세 제품 소개</h2></div>
    <div class="lg:col-span-8">
      {% if summary %}<p class="text-lg text-navy-900 font-medium leading-relaxed break-keep max-w-2xl">{{ summary }}</p>{% endif %}
      <article class="mt-6 prose prose-slate max-w-2xl prose-h2:text-xl prose-h2:font-bold prose-h2:text-navy-900 prose-h2:mt-8 prose-h2:mb-3 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600 break-keep">
        {{ content | safe }}
      </article>
    </div>
  </div>
</section>

{# ───── 카탈로그 다운로드 · 문의 ───── #}
<section class="bg-navy-900 py-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold text-white break-keep">{{ ap.cta.title }}</h2>
      <p class="mt-2 text-slate-300 break-keep">{{ ap.cta.text }}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="{{ dl }}" {% if brochure %}download{% endif %} class="inline-flex items-center bg-[#1d63d8] hover:bg-techblue-500 text-white font-bold px-6 py-3.5 rounded-lg transition-colors">제품 카탈로그 다운로드</a>
      <a href="/contact/" class="inline-flex items-center border-2 border-white/40 hover:bg-white/10 text-white font-bold px-6 py-3 rounded-lg transition-colors">문의하기</a>
    </div>
  </div>
</section>
